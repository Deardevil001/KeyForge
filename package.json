{
  "name": "keyforge-website",
  "version": "1.0.0",
  "private": true,
  "description": "KeyForge key management portal and verification API",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node --check server.js && node --check netlify/functions/api.mjs && node --check public/app.js",
    "netlify:dev": "netlify dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.3.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": { "netlify-cli": "^27.17.0" }
}
